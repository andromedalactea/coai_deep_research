# =============================================================================
# CORE API KEYS
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# =============================================================================
# E2B CODE EXECUTION (Required for computational experiments)
# =============================================================================
# Get your key at: https://e2b.dev/dashboard
E2B_API_KEY=

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Main research model (format: provider:model)
# Examples: openai:gpt-4o, anthropic:claude-3-5-sonnet-20241022, deepseek:deepseek-chat
RESEARCH_MODEL=openai:gpt-4o

# Model for final report synthesis (can be different, e.g., a more capable model)
FINAL_REPORT_MODEL=openai:gpt-4o

# Model for summarization (can be a faster/cheaper model)
SUMMARIZATION_MODEL=openai:gpt-4o-mini

# =============================================================================
# VISION MODEL FOR IMAGE ANALYSIS (RECOMMENDED)
# =============================================================================
# Used to analyze generated plots and figures
# Best options: Google Gemini (best for scientific), GPT-4V, Claude 3
# Format: provider:model (e.g., google:gemini-3.0-flash)

# Google Gemini (recommended - best at scientific figures)
VISION_MODEL=google:gemini-3-flash-preview

# Alternative: Use OpenAI GPT-4V
# VISION_MODEL=openai:gpt-4o

# Alternative: Use Anthropic Claude 3
# VISION_MODEL=anthropic:claude-3-5-sonnet-20241022

# =============================================================================
# CODE FIXER MODEL (for debugging failed experiments)
# =============================================================================
# Powerful model used to fix code that fails during execution
# Recommended: Claude Opus 4.5 or GPT-5 for best results
# This model gets full context about why code failed and must produce working code
CODE_FIXER_MODEL=anthropic:claude-sonnet-4-5-20250514

# =============================================================================
# COMPUTATIONAL DISCOVERY SETTINGS
# =============================================================================
# LangGraph recursion limit (default: 100, increase for complex research)
RECURSION_LIMIT=150

# Max code fix attempts when E2B execution fails
MAX_CODE_FIX_ATTEMPTS=5

# Minimum quality score (0-1) for experiment results
MIN_EXPERIMENT_QUALITY=0.4

# Whether to require statistical tests in experiments
REQUIRE_STATISTICAL_TESTS=true

# Whether to require visualizations in experiments
REQUIRE_VISUALIZATIONS=true

# =============================================================================
# LANGSMITH TRACING (Optional but recommended for debugging)
# =============================================================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# =============================================================================
# OPEN AGENT PLATFORM (Optional)
# =============================================================================
# Only necessary for Open Agent Platform deployment
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform
GET_API_KEYS_FROM_CONFIG=false